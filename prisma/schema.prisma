
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  APPLICANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SCREENED
  SHORTLISTED
  INTERVIEWING
  HIRED
  REJECTED
  RESERVE_1
  RESERVE_2
  RESERVE_3
}

enum MatchRating {
  HIGH
  MEDIUM
  LOW
  UNQUALIFIED
}

// Competency Test Enums

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum CompetencyTestStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TestAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  GRADED
  EXPIRED
}

// ==========================================
// EXISTING MODELS
// ==========================================

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole   @default(APPLICANT)
  status        UserStatus @default(ACTIVE)

  candidate     Candidate?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model JobPosting {
  id             String        @id @default(cuid())
  title          String
  departments    String[]
  description    String        @db.Text
  minYearsExp    Int           @default(0)
  requiredSkills String[]
  deadline       DateTime?
  isHidden       Boolean       @default(false)

  applications   Application[]
  competencyTests CompetencyTest[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Candidate {
  id                String        @id @default(cuid())
  userId            String?       @unique
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName          String
  email             String        @unique
  phone             String
  location          String
  department        String
  professionalTitle String
  yearsOfExperience Int           @default(0)
  bioSummary        String?       @db.Text
  applications      Application[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Application {
  id                String            @id @default(cuid())
  jobId             String
  candidateId       String
  job               JobPosting        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate         Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  documentsUrl      String
  parsedText        String?           @db.Text
  extractedSkills   String[]
  yearsOfExperience Int               @default(0)
  status            ApplicationStatus @default(SUBMITTED)
  scoreResult       ScoreResult?
  testAssignments   TestAssignment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId, status])
}

model ScoreResult {
  id              String      @id @default(cuid())
  applicationId   String      @unique
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  matchRating     MatchRating
  skillsMatched   String[]
  missingSkills   String[]
  summary         String?     @db.Text
  technicalScore  Float?
  behavioralScore Float?
  createdAt       DateTime    @default(now())
}

// ==========================================
// COMPETENCY TEST MODELS
// ==========================================

model CompetencyTest {
  id          String               @id @default(cuid())
  title       String
  description String?              @db.Text
  duration    Int
  status      CompetencyTestStatus @default(DRAFT)

  questions   TestQuestion[]
  assignments TestAssignment[]

  // A test can be connected to multiple job postings
  jobs        JobPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestQuestion {
  id     String         @id @default(cuid())
  testId String
  test   CompetencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  question String       @db.Text
  type     QuestionType
  points   Float        @default(1)
  order    Int

  options TestOption[]
  answers TestAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, order])
}

model TestOption {
  id         String       @id @default(cuid())
  questionId String
  question   TestQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  text      String
  isCorrect Boolean @default(false)

  answers TestAnswer[]

  createdAt DateTime @default(now())
}

model TestAssignment {
  id            String @id @default(cuid())
  testId        String
  applicationId String

  test        CompetencyTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status      TestAssignmentStatus @default(ASSIGNED)
  assignedAt  DateTime             @default(now())
  startedAt   DateTime?
  submittedAt DateTime?
  deadline    DateTime?

  score   Float?
  answers TestAnswer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([testId, applicationId])
}

model TestAnswer {
  id               String  @id @default(cuid())
  assignmentId     String
  questionId       String
  selectedOptionId String?

  assignment     TestAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  question       TestQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption TestOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  responseText  String?   @db.Text
  pointsAwarded Float?
  feedback      String?   @db.Text
  gradedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, questionId])
}
